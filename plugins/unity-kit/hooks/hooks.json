{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/guard-paths.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/stop-checks.sh\"",
            "timeout": 600,
            "statusMessage": "unity-kit: checking .meta files, asset references and compilation"
          }
        ]
      }
    ]
  }
}
